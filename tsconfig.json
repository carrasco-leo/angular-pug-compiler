{
	"compilerOptions": {
		"target": "es2022",
		"rootDir": "src",

		"strict": true,
		"strictPropertyInitialization": false,
		"strictNullChecks": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,

		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,

		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "lib", "dist"]
}
