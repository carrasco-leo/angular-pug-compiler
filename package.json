			"require": "./lib/commonjs/compiler.cjs"
		}
	},
	"scripts": {
		"test": "jest"
	},
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/carrasco-leo/angular-pug-compiler.git"
	},
	"bugs": {
		"url": "https://github.com/carrasco-leo/angular-pug-compiler/issues"
	},
	"homepage": "https://github.com/carrasco-leo/angular-pug-compiler#readme",
	"dependencies": {
		"chokidar": "^3.6.0",
		"glob": "^10.0.0",
		"pug": "^3.0.0"
	},
	"devDependencies": {
		"jest": "^29.7.0"
	}
}
